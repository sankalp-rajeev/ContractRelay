    {
      "name": "get_paper",
      "description": "\n\tGet detailed information about a specific arXiv paper.\n\n\tArgs:\n\t\tid_or_url: arXiv paper ID (e.g., '2301.00001') or full arXiv URL\n\n\tReturns:\n\t\tPaper details including title, abstract, authors, categories, and URLs\n\t",
      "inputSchema": {
