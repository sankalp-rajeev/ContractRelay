{
  "tools": [
    {
      "name": "search",
      "description": "\n\tSearch arXiv for papers matching the query.\n\n\tArgs:\n\t\tquery: Search query for arXiv papers (e.g., 'LLM', 'transformer architecture')\n\t\tcategory: Filter by arXiv category (e.g., 'cs.AI', 'cs.LG', 'stat.ML')\n\t\tauthor: Filter by author name\n\t\tsort_by: Sort order - 'relevance', 'date_desc', 'date_asc'\n\t\tpage: Page number (default: 1)\n\t\tpage_size: Results per page, max 50 (default: 25)\n\n\tReturns:\n\t\tSearch results with papers containing title, abstract, authors, and URLs\n\t",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Category"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Author"
          },
          "sort_by": {
            "default": "relevance",
            "title": "Sort By",
            "type": "string"
          },
          "page": {
            "default": 1,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 25,
            "title": "Page Size",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "searchArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "description": "The search query used",
            "title": "Query",
            "type": "string"
          },
          "total_results": {
            "description": "Total number of results found",
            "title": "Total Results",
            "type": "integer"
          },
          "papers": {
            "description": "List of papers",
            "items": {
              "$ref": "#/$defs/Paper"
            },
            "title": "Papers",
            "type": "array"
          },
          "page": {
            "default": 1,
            "description": "Current page number",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 25,
            "description": "Number of results per page",
            "title": "Page Size",
            "type": "integer"
          },
          "has_more": {
            "default": false,
            "description": "Whether more results exist",
            "title": "Has More",
            "type": "boolean"
          },
          "next_page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Next page number if has_more is True",
            "title": "Next Page"
          }
        },
        "required": [
          "query",
          "total_results",
          "papers"
        ],
        "$defs": {
          "Paper": {
            "description": "Represents an arXiv paper.",
            "properties": {
              "id_arxiv": {
                "description": "arXiv paper ID (e.g., '2301.00001')",
                "title": "Id Arxiv",
                "type": "string"
              },
              "title": {
                "description": "Paper title",
                "title": "Title",
                "type": "string"
              },
              "abstract": {
                "description": "Paper abstract",
                "title": "Abstract",
                "type": "string"
              },
              "authors": {
                "description": "List of authors",
                "items": {
                  "type": "string"
                },
                "title": "Authors",
                "type": "array"
              },
              "categories": {
                "description": "arXiv categories",
                "items": {
                  "type": "string"
                },
                "title": "Categories",
                "type": "array"
              },
              "url_abstract": {
                "description": "URL to the abstract page",
                "title": "Url Abstract",
                "type": "string"
              },
              "url_pdf": {
                "description": "URL to the PDF",
                "title": "Url Pdf",
                "type": "string"
              },
              "date_published": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Publication date",
                "title": "Date Published"
              },
              "date_updated": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Last updated date",
                "title": "Date Updated"
              }
            },
            "required": [
              "id_arxiv",
              "title",
              "abstract",
              "url_abstract",
              "url_pdf"
            ],
            "title": "Paper",
            "type": "object"
          }
        },
        "description": "Search result containing papers and metadata.",
        "title": "SearchResult"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
