{
  "tools": [
    {
      "name": "get_weather",
      "description": "Return the current temperature in Fahrenheit and conditions for a city.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "city"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number"
          },
          "conditions": {
            "type": "string"
          }
        },
        "required": [
          "temperature",
          "conditions"
        ],
        "additionalProperties": false
      }
    }
  ]
}
