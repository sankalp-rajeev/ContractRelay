# No API key is needed for install, lint, typecheck, tests, or the local demo.
# Used by pnpm synthesize:weather; configure a key from your free-tier project.
GEMINI_API_KEY=
CONTRACTRELAY_DEV_MODEL=gemini-3.5-flash-lite
CONTRACTRELAY_FINAL_MODEL=gemini-3.8-flash
CONTRACTRELAY_MODEL_MODE=dev
CONTRACTRELAY_MAX_CONCURRENCY=1
# off | dev; final independent trials always bypass caching.
CONTRACTRELAY_CACHE_MODE=off
# Quotas are a PRD snapshot, not verified live account limits.
CONTRACTRELAY_DEV_RPM=15
CONTRACTRELAY_DEV_TPM=250000
CONTRACTRELAY_DEV_RPD_HARD=500
CONTRACTRELAY_DEV_RPD_SOFT=450
CONTRACTRELAY_FINAL_RPM=5
CONTRACTRELAY_FINAL_TPM=250000
CONTRACTRELAY_FINAL_RPD_HARD=20
CONTRACTRELAY_FINAL_RPD_SOFT=18
