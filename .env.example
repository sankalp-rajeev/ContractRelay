# No API key is needed for install, lint, typecheck, tests, or the local demo.
# Used by synthesis/benchmarks; Phase 5 uses the user-authorized Tier 1 project.
GEMINI_API_KEY=
CONTRACTRELAY_DEV_MODEL=gemini-3.5-flash-lite
CONTRACTRELAY_FINAL_MODEL=gemini-3.8-flash
CONTRACTRELAY_MODEL_MODE=dev
# Default: final=4, development=1. Optional override accepts integers 1–5.
# CONTRACTRELAY_MAX_CONCURRENCY=4
# off | dev; final independent trials always bypass caching.
CONTRACTRELAY_CACHE_MODE=off
# Development quotas retain the PRD snapshot. Final quotas are the user's Tier 1 limits.
CONTRACTRELAY_DEV_RPM=15
CONTRACTRELAY_DEV_TPM=250000
CONTRACTRELAY_DEV_RPD_HARD=500
CONTRACTRELAY_DEV_RPD_SOFT=450
CONTRACTRELAY_FINAL_RPM=1000
CONTRACTRELAY_FINAL_TPM=2000000
CONTRACTRELAY_FINAL_RPD_HARD=10000
CONTRACTRELAY_FINAL_RPD_SOFT=10000
