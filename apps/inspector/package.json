{
  "name": "contractrelay-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/public-artifacts.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/public-artifacts.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-deployment.mjs",
    "start": "next start --hostname 127.0.0.1",
    "codegen": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node scripts/public-artifacts.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:protected": "node scripts/audit-protected.mjs",
    "check": "npm run codegen && npm run typecheck && npm run lint && npm test && npm run audit:protected"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "graphql": "16.11.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
